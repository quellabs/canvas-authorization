{
  "name": "quellabs/canvas-authorization",
  "description": "",
  "keywords": [
    "canvas-framework"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/quellabs/canvas-authorization",
  "support": {
    "issues": "https://github.com/quellabs/canvas-authorization/issues",
    "source": "https://github.com/quellabs/canvas-authorization"
  },
  "authors": [
    {
      "name": "Quellabs",
      "email": "support@quellabs.com",
      "homepage": "https://www.canvasphp.com"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "platform": {
      "php": "8.3"
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "classmap-authoritative": true,
    "allow-plugins": {
      "quellabs/discover": true
    }
  },
  "require": {
    "php": ">=8.3",
    "ext-openssl": "*",
    "quellabs/canvas": "^1.",
    "quellabs/contracts": "^1.",
    "quellabs/dependency-injection": "^1.",
    "quellabs/objectquel": "^2.",
    "quellabs/sculpt": "^1.",
    "quellabs/support": "^1.",
    "symfony/http-client": "^7.0 || ^8.0",
    "symfony/http-foundation": "^7.0 || ^8.0",
    "web-token/jwt-library": "^4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Quellabs\\CanvasAuthorization\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Quellabs\\CanvasAuthorization\\Tests\\": "tests/"
    }
  },
  "extra": {
    "discover": {
      "sculpt": {
        "provider": "Quellabs\\CanvasAuthorization\\ServiceProvider"
      },
      "di": {
        "provider": "Quellabs\\CanvasAuthorization\\OidcServiceProvider"
      }
    }
  }
}
